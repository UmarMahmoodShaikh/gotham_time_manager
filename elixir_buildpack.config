# HashNuke Heroku Elixir buildpack configuration
# See: https://github.com/HashNuke/heroku-buildpack-elixir#configuration

# Versions: choose ones compatible with your project and Heroku-24 stack
# Based on mix.exs which requires Elixir ~> 1.15. Use a compatible Elixir and OTP pair.
elixir_version=1.17.3
# Use an OTP 26 patch that is supported by the buildpack and Heroku-24
# (OTP 27 is not yet available on the buildpack for Heroku-24)
erlang_version=26.2.4

# Optional: set the package manager for assets (npm or yarn)
# Default is npm; change to yarn if your project uses yarn.lock
NODE_INSTALL_METHOD=default

# The directory your app is in (root by default)
appdir="."

# Rebuild policy
always_rebuild=false

# Commands to run before building the release (assets build etc.)
# Using Mix aliases defined in mix.exs (assets.setup, assets.deploy)
hook_pre_compile="mix assets.setup && MIX_ENV=prod mix assets.deploy"

# Commands to run after compiling (digest is part of assets.deploy already)
hook_post_compile=""
